# ==============================================================================
# CORTEXLAB: Root Git Ignore Rules
# Protects all secret environment files, virtual environments, and build artifacts
# ==============================================================================

# Environment files and Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.local
.env.local
.env.*.local
*.pem
*.key

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.npm/

# Python / Backend / ML
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database / Local Stores
*.sqlite3
*.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
