# ============================================================
# CORTEXLAB — Frontend Environment Configuration Template
# Copy this file to .env.local and add your API keys.
# ============================================================

# Groq API key (Get free instant LPU access at https://console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Supabase PostgreSQL + pgvector (Get free project at https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API key (Get at https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (Optional)
VITE_OPENAI_API_KEY=your_openai_api_key_here
